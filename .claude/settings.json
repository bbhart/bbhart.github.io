{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push:*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-cleanup-before-publish.sh",
            "statusMessage": "Checking for unresolved <<markers>> in published posts"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(awk:*)",
      "Bash(ruby:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(sips:*)",
      "Bash(mdls:*)",
      "Bash(sort:*)",
      "Bash(exiftool:*)",
      "Bash(find:*)",
      "Bash(sleep:*)",
      "Bash(/bin/sleep:*)",
      "Bash(touch:*)",
      "Bash(test:*)",
      "Bash(cp:*)",
      "Bash(xxd:*)",
      "Bash(date:*)",
      "Bash(seq:*)",
      "Bash(which:*)",
      "Bash(env)",
      "Bash(open:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(sed:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg:*)",
      "Bash(bundle:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(for:*)",
      "Bash(while:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo:*)"
    ],
    "ask": []
  }
}
